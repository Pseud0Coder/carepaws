rules_version = '2';

// All data access happens from the client, so these rules are the API's
// authorization layer. The app runs completely on Firebase's free Spark plan: there are no Cloud Functions in
// the live set-up. Totals that other people must not be able to fake (ratings, completed stays, vouch counts) are
// updated by the app inside the same batch as the thing they count, and the rules check the arithmetic.
// "Verified" badges are set only by the admin CLI (functions/admin.mjs), which bypasses rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function data() { return request.resource.data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function userDoc(id) { return get(/databases/$(database)/documents/users/$(id)).data; }

    // A real person: a confirmed email address (Google accounts always have one) or a confirmed mobile number.
    function verifiedPerson() {
      return 'phone_number' in request.auth.token
        || ('email_verified' in request.auth.token && request.auth.token.email_verified == true);
    }

    function isStr(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optStr(m, k, max) { return !(k in m) || (m[k] is string && m[k].size() <= max); }
    function optStrList(m, k) { return !(k in m) || (m[k] is list && m[k].size() <= 20); }

    // "YYYY-MM-DD" -> timestamp at UTC midnight
    function isDay(s) { return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function day(s) {
      return timestamp.date(int(s.split('-')[0]), int(s.split('-')[1]), int(s.split('-')[2]));
    }


    // ─── Service area: Hyderabad ──────────────────────────────────────────
    // Generated from src/lib/hyderabad-areas.json; tests/areas.test.mjs fails if they drift apart.
    function hydArea(a) {
      return a is string && a in [
        // BEGIN hyderabad-areas
        'AS Rao Nagar',
        'Abids',
        'Alwal',
        'Ameerpet',
        'Attapur',
        'Bachupally',
        'Banjara Hills',
        'Begumpet',
        'Boduppal',
        'Bowenpally',
        'Chandanagar',
        'Charminar and Old City',
        'Dilsukhnagar',
        'ECIL',
        'Erragadda',
        'Film Nagar',
        'Financial District',
        'Gachibowli',
        'Golconda',
        'HITEC City',
        'Habsiguda',
        'Hafeezpet',
        'Himayatnagar',
        'Jubilee Hills',
        'KPHB Colony',
        'Khairatabad',
        'Khajaguda',
        'Kokapet',
        'Kompally',
        'Kondapur',
        'Kothapet',
        'Kukatpally',
        'LB Nagar',
        'Langar Houz',
        'Lingampally',
        'Madhapur',
        'Malkajgiri',
        'Manikonda',
        'Medchal',
        'Mehdipatnam',
        'Miyapur',
        'Moosapet',
        'Musheerabad',
        'Nacharam',
        'Nagole',
        'Nallakunta',
        'Nampally',
        'Nanakramguda',
        'Narsingi',
        'Nizampet',
        'Panjagutta',
        'Patancheru',
        'Pragathi Nagar',
        'Raidurg',
        'Rajendranagar',
        'SR Nagar',
        'Sainikpuri',
        'Secunderabad',
        'Shaikpet',
        'Shamshabad',
        'Somajiguda',
        'Tarnaka',
        'Tellapur',
        'Tolichowki',
        'Trimulgherry',
        'Uppal',
        'Vanasthalipuram'
        // END hyderabad-areas
      ];
    }
    function inHyderabad(lat, lng) {
      return lat is number && lng is number
        && lat >= 17.15 && lat <= 17.75 && lng >= 78.1 && lng <= 78.75;
    }

    // ─── Users ─────────────────────────────────────────────────────────────
    // Public profile. Contact details live in the private subcollection.
    // System fields (verified, backgroundChecked) are not in editableFields, so clients can never set them. The
    // counters (rating, reviewCount, completedStays, vouchCount) only move through the checked branches below.
    match /users/{userId} {
      function editableFields() {
        return ['uid', 'displayName', 'photoURL', 'role', 'onboarded', 'location', 'bio',
                'services', 'petTypes', 'pricePerNight', 'experience', 'availability',
                'responseTime', 'home', 'phone', 'address', 'lat', 'lng', 'hours', 'open24x7', 'area',
                'website', 'createdAt', 'updatedAt'];
      }
      // A sitter can't go live until they have submitted identity verification.
      function kycOk() {
        return exists(/databases/$(database)/documents/kyc/$(userId))
          && get(/databases/$(database)/documents/kyc/$(userId)).data.status in ['submitted', 'approved'];
      }
      function validHome(m) {
        return !('home' in m)
          || (m.role == 'sitter' && m.home is map
              && m.home.keys().hasOnly(['type', 'fencedYard', 'hasOwnPets', 'ownPets', 'children', 'smokeFree', 'maxHoursAlone'])
              && m.home.type in ['apartment', 'house', 'farm']
              && m.home.fencedYard is bool && m.home.hasOwnPets is bool
              && m.home.children is bool && m.home.smokeFree is bool
              && m.home.ownPets is string && m.home.ownPets.size() <= 100
              && m.home.maxHoursAlone is int && m.home.maxHoursAlone >= 0 && m.home.maxHoursAlone <= 12);
      }
      // Organisations publish a phone number on purpose. People never do:
      // theirs stays in the owner-only private/contact document.
      function validOrg(m) {
        return !(m.role == 'rescue' || m.role == 'vet')
          ? !m.keys().hasAny(['phone', 'address', 'lat', 'lng', 'hours', 'open24x7', 'website'])
          : optStr(m, 'address', 160) && optStr(m, 'hours', 80)
            && (!('phone' in m) || (m.phone is string && m.phone.matches('^[+0-9 ()-]{7,20}$')))
            && (!('website' in m) || (m.website is string && m.website.size() <= 200
                  && (m.website == '' || m.website.matches('^https?://.*'))))
            && (!('open24x7' in m) || m.open24x7 is bool)
            && (!('lat' in m) || (m.lat is number && m.lat >= -90 && m.lat <= 90))
            && (!('lng' in m) || (m.lng is number && m.lng >= -180 && m.lng <= 180))
            // Listings are for Hyderabad: a pinned point must be inside the service area.
            && (!('lat' in m && 'lng' in m) || inHyderabad(m.lat, m.lng))
            // A listing can't go live without a way to reach it.
            && (m.onboarded != true || (m.phone is string && m.address is string && m.address.size() > 0
                  && 'location' in m && m.location is string && m.location.size() > 0));
      }
      function validProfile(m) {
        return isStr(m.displayName, 1, 60)
          && (m.role == null || m.role in ['parent', 'sitter', 'explorer', 'rescue', 'vet'])
          && validOrg(m)
          && validHome(m)
          && m.onboarded is bool
          // A link (Google's photo), or a small JPEG kept in the profile itself.
          && (!('photoURL' in m) || m.photoURL == null || m.photoURL == ''
              || (m.photoURL is string && m.photoURL.size() <= 2048 && m.photoURL.matches('^https://.*'))
              || (m.photoURL is string && m.photoURL.size() <= 40023 && m.photoURL.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')))
          && optStr(m, 'location', 80)
          && (!('area' in m) || hydArea(m.area))
          // Everyone except someone just looking around says which Hyderabad neighbourhood they are in.
          && (!(m.onboarded == true && m.role in ['parent', 'sitter', 'rescue', 'vet']) || hydArea(m.area))
          // Real accounts only: a parent or sitter must have a confirmed email or mobile number (both are in the sign-in token).
          && (!(m.onboarded == true && m.role in ['parent', 'sitter']) || verifiedPerson())
          && optStr(m, 'bio', 600)
          && optStr(m, 'experience', 30)
          && optStr(m, 'responseTime', 40)
          && optStrList(m, 'services')
          && optStrList(m, 'petTypes')
          && optStrList(m, 'availability')
          && (!('pricePerNight' in m) || (m.pricePerNight is int && m.pricePerNight >= 100 && m.pricePerNight <= 100000))
          // A sitter can't go live without a rate and the pets they take.
          && (!(m.role == 'sitter' && m.onboarded == true)
              || (m.pricePerNight is int && m.petTypes is list && m.petTypes.size() > 0 && kycOk()));
      }

      allow read: if true;
      allow create: if signedIn() && uid() == userId
        && data().uid == userId
        && data().keys().hasOnly(editableFields())
        && validProfile(data());
      function ownEdit() {
        return uid() == userId
          && changed().hasOnly(editableFields())
          && !changed().hasAny(['uid'])
          // Role is fixed once onboarding is finished, except that someone who was just
          // looking around may choose a role later (and then completes onboarding for it).
          && (data().role == resource.data.role || resource.data.onboarded == false || resource.data.role == 'explorer')
          && validProfile(data());
      }
      // The sitter's public "stays done" count goes up by one, in the same batch that marks that booking completed.
      function stayCounted() {
        return uid() == userId
          && changed().hasOnly(['completedStays', 'lastCompleted'])
          && data().lastCompleted is string
          && data().completedStays == resource.data.get('completedStays', 0) + 1
          && get(/databases/$(database)/documents/bookings/$(data().lastCompleted)).data.status == 'confirmed'
          && getAfter(/databases/$(database)/documents/bookings/$(data().lastCompleted)).data.status == 'completed'
          && getAfter(/databases/$(database)/documents/bookings/$(data().lastCompleted)).data.sitterId == userId;
      }
      // A parent's new review is folded into the sitter's rating, in the same batch that writes the review.
      // rating is the average of the stars to one decimal place; the rules check it against the sum and the count.
      function reviewCounted() {
        let rid = data().lastReview;
        return uid() != userId
          && changed().hasOnly(['reviewCount', 'ratingSum', 'rating', 'topRated', 'lastReview'])
          && rid is string
          && !exists(/databases/$(database)/documents/reviews/$(rid))
          && existsAfter(/databases/$(database)/documents/reviews/$(rid))
          && getAfter(/databases/$(database)/documents/reviews/$(rid)).data.sitterId == userId
          && getAfter(/databases/$(database)/documents/reviews/$(rid)).data.authorId == uid()
          && data().reviewCount == resource.data.get('reviewCount', 0) + 1
          && data().ratingSum == resource.data.get('ratingSum', 0) + getAfter(/databases/$(database)/documents/reviews/$(rid)).data.rating
          && math.abs(data().rating - float(data().ratingSum) / data().reviewCount) <= 0.051
          && data().topRated == (data().reviewCount >= 10 && data().rating >= 4.8);
      }
      // A verified rescue or clinic's vouch is added to (or withdrawn from) the sitter's count, in the same batch.
      function vouchCounted() {
        let vid = data().lastVouch;
        let vouch = /databases/$(database)/documents/vouches/$(vid);
        let added = !exists(vouch) && existsAfter(vouch);
        let withdrawn = exists(vouch) && !existsAfter(vouch);
        return uid() != userId
          && changed().hasOnly(['vouchCount', 'lastVouch'])
          && vid == uid() + '_' + userId
          && (added || withdrawn)
          && data().vouchCount == resource.data.get('vouchCount', 0) + (added ? 1 : -1)
          && data().vouchCount >= 0;
      }

      allow update: if signedIn() && (ownEdit() || stayCounted() || reviewCounted() || vouchCounted());
      // Account deletion. (The app removes private data and photos first, and signs the person out of Firebase last.)
      allow delete: if signedIn() && uid() == userId;

      match /private/{docId} {
        allow read, write: if signedIn() && uid() == userId;
      }

      // People this user has blocked. Other rules consult it, so a blocked person can't message or book them.
      match /blocked/{otherId} {
        allow read: if signedIn() && uid() == userId;
        allow create: if signedIn() && uid() == userId && otherId != userId
          && data().keys().hasOnly(['createdAt']) && data().createdAt == request.time;
        allow delete: if signedIn() && uid() == userId;
        allow update: if false;
      }
    }

    // ─── Identity verification (KYC) ────────────────────────────────────────
    // A sitter's case. Only the owner can read it, and only an admin (Admin SDK, which
    // bypasses rules) can move it past "submitted" or set the sitter's verified badge.
    // The ID photos are saved as base64 text in kyc/{uid}/files/{name} (write-only for the owner; the admin CLI
    // reads them) because Cloud Storage needs the paid plan.
    // Full ID numbers are never collected, only the last four characters.
    match /kyc/{userId} {
      // The case points at its own saved photos, and each photo must really have been saved.
      function ownFile(path, name) {
        return path == 'kyc/' + userId + '/' + name
          && exists(/databases/$(database)/documents/kyc/$(userId)/files/$(name));
      }
      function validKyc(m) {
        return m.keys().hasOnly(['status', 'legalName', 'dob', 'idType', 'idLast4', 'addressLine', 'city',
              'pincode', 'emergencyName', 'emergencyPhone', 'idFront', 'idBack', 'selfie', 'addressProof',
              'policeCert', 'hasPoliceCert', 'declarations', 'consent', 'consentAt', 'submittedAt'])
          && m.status == 'submitted'
          && userDoc(userId).role == 'sitter'
          // A confirmed email or mobile number, read from the sign-in token.
          && verifiedPerson()
          && isStr(m.legalName, 2, 80)
          && isDay(m.dob) && day(m.dob) <= request.time - duration.value(6575, 'd')
          && m.idType in ['aadhaar', 'pan', 'passport', 'driving_licence', 'voter_id']
          && m.idLast4 is string && m.idLast4.matches('^[A-Za-z0-9]{4}$')
          && isStr(m.addressLine, 5, 160) && isStr(m.city, 2, 60)
          && m.pincode is string && m.pincode.matches('^50[0-2][0-9]{3}$')
          && isStr(m.emergencyName, 2, 60)
          && m.emergencyPhone is string && m.emergencyPhone.matches('^[+0-9 ()-]{7,20}$')
          && ownFile(m.idFront, 'id-front')
          && ownFile(m.selfie, 'selfie')
          && (m.idType == 'pan' || ('idBack' in m && ownFile(m.idBack, 'id-back')))
          && (m.idType != 'pan' || ('addressProof' in m && ownFile(m.addressProof, 'address-proof')))
          && (!('policeCert' in m) || ownFile(m.policeCert, 'police-cert'))
          && m.hasPoliceCert == ('policeCert' in m)
          && m.consent == true && m.consentAt == request.time && m.submittedAt == request.time
          && m.declarations.keys().hasOnly(['version', 'honestProfile', 'safeHome', 'ownPetsDisclosed',
                'noUnattended', 'dailyUpdates', 'personalCare', 'humaneHandling', 'emergencyPlan', 'reportIncidents'])
          && m.declarations.version == 1
          && m.declarations.honestProfile == true && m.declarations.safeHome == true
          && m.declarations.ownPetsDisclosed == true && m.declarations.noUnattended == true
          && m.declarations.dailyUpdates == true && m.declarations.personalCare == true
          && m.declarations.humaneHandling == true && m.declarations.emergencyPlan == true
          && m.declarations.reportIncidents == true;
      }

      allow read: if signedIn() && uid() == userId;
      allow create: if signedIn() && uid() == userId && validKyc(data());
      // After a rejection the sitter may fix it and resubmit. Approved cases are frozen.
      allow update: if signedIn() && uid() == userId && resource.data.status == 'rejected' && validKyc(data());
      // Only as the last step of deleting the account (the profile is already gone by then).
      allow delete: if signedIn() && uid() == userId && !exists(/databases/$(database)/documents/users/$(userId));

      // The photos of the documents and the selfie. The owner can save them while there is no case or after a
      // rejection, and can never read them back; the admin CLI deletes them once a decision is made.
      match /files/{name} {
        allow read: if false;
        allow create, update: if signedIn() && uid() == userId
          && name in ['id-front', 'id-back', 'selfie', 'address-proof', 'police-cert']
          && userDoc(userId).role == 'sitter'
          && data().keys().hasOnly(['b64', 'createdAt'])
          && data().b64 is string && data().b64.size() > 100 && data().b64.size() <= 750000
          && data().createdAt == request.time
          && (!exists(/databases/$(database)/documents/kyc/$(userId))
              || get(/databases/$(database)/documents/kyc/$(userId)).data.status == 'rejected');
        allow delete: if signedIn() && uid() == userId && !exists(/databases/$(database)/documents/users/$(userId));
      }
    }

    // ─── Pets ──────────────────────────────────────────────────────────────
    // Only the owner can see pets; sitters get a snapshot copied into bookings.
    match /pets/{petId} {
      function validPet(m) {
        return m.keys().hasOnly(['ownerId', 'name', 'type', 'breed', 'age', 'notes', 'createdAt',
              'sex', 'neutered', 'weightKg', 'vaccinated', 'vaccinatedOn', 'tempers', 'medical',
              'medications', 'diet', 'vetName', 'vetPhone', 'microchip'])
          && isStr(m.name, 1, 40) && isStr(m.type, 1, 20)
          && optStr(m, 'breed', 60) && optStr(m, 'age', 20) && optStr(m, 'notes', 1000)
          && (!('sex' in m) || m.sex in ['male', 'female'])
          && (!('neutered' in m) || m.neutered is bool)
          && (!('microchip' in m) || m.microchip is bool)
          && (!('weightKg' in m) || (m.weightKg is number && m.weightKg > 0 && m.weightKg <= 120))
          && (!('vaccinated' in m) || m.vaccinated in ['up_to_date', 'partial', 'none'])
          && (!('vaccinatedOn' in m) || isDay(m.vaccinatedOn))
          && (!('tempers' in m) || (m.tempers is list && m.tempers.size() <= 12))
          && optStr(m, 'medical', 500) && optStr(m, 'medications', 500) && optStr(m, 'diet', 500)
          && optStr(m, 'vetName', 80)
          && (!('vetPhone' in m) || (m.vetPhone is string && (m.vetPhone == '' || m.vetPhone.matches('^[+0-9 ()-]{7,20}$'))));
      }
      allow read: if signedIn() && resource.data.ownerId == uid();
      allow create: if signedIn() && data().ownerId == uid() && validPet(data());
      allow update: if signedIn() && resource.data.ownerId == uid()
        && data().ownerId == uid() && validPet(data());
      allow delete: if signedIn() && resource.data.ownerId == uid();
    }

    // ─── Bookings ──────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      function isParent() { return uid() == resource.data.parentId; }
      function isSitter() { return uid() == resource.data.sitterId; }

      // The care sheet snapshot. A booking can only be made for a pet whose vaccinations are up to date,
      // which keeps the "vaccinated" declaration consistent with what the sitter reads.
      function validPetCare(c) {
        return c is map
          && c.keys().hasOnly(['sex', 'neutered', 'weightKg', 'vaccinated', 'vaccinatedOn', 'tempers', 'medical',
                'medications', 'diet', 'vetName', 'vetPhone', 'microchip'])
          && c.vaccinated == 'up_to_date'
          && (!('tempers' in c) || (c.tempers is list && c.tempers.size() <= 12))
          && optStr(c, 'medical', 500) && optStr(c, 'medications', 500) && optStr(c, 'diet', 500)
          && optStr(c, 'vetName', 80) && optStr(c, 'vetPhone', 20);
      }

      // The pet parent's signed declarations: every one must be affirmed, with a version and the signing time.
      function validDeclarations(d, atHome) {
        return d is map
          && d.keys().hasOnly(['version', 'vaccinated', 'parasiteControl', 'healthDisclosed', 'behaviourDisclosed',
                'noContagious', 'ownerAuthorised', 'conditionRecord', 'inherentRisk', 'emergencyAuth', 'policy',
                'homePetProofed', 'homeHazardsDisclosed', 'homeAccessSafe', 'emergencyLimit',
                'emergencyContactName', 'emergencyContactPhone', 'preferredVetName', 'preferredVetPhone', 'acceptedAt'])
          && d.version == 1
          && d.vaccinated == true && d.parasiteControl == true && d.healthDisclosed == true
          && d.behaviourDisclosed == true && d.noContagious == true && d.ownerAuthorised == true
          && d.conditionRecord == true && d.inherentRisk == true && d.emergencyAuth == true && d.policy == true
          && (!atHome || (d.homePetProofed == true && d.homeHazardsDisclosed == true && d.homeAccessSafe == true))
          && d.emergencyLimit is int && d.emergencyLimit >= 1000 && d.emergencyLimit <= 100000
          && isStr(d.emergencyContactName, 2, 60)
          && d.emergencyContactPhone is string && d.emergencyContactPhone.matches('^[+0-9 ()-]{7,20}$')
          && optStr(d, 'preferredVetName', 80) && optStr(d, 'preferredVetPhone', 20)
          && d.acceptedAt == request.time;
      }

      function validNew(b) {
        let sitter = userDoc(b.sitterId);
        let pet = get(/databases/$(database)/documents/pets/$(b.petId)).data;
        return b.keys().hasOnly(['sitterId', 'sitterName', 'sitterPhoto', 'parentId', 'parentName',
              'parentPhoto', 'petId', 'petName', 'petType', 'petNotes', 'startDate', 'endDate',
              'nights', 'pricePerNight', 'totalPrice', 'status', 'paymentStatus', 'notes',
              'careLocation', 'petCare', 'declarations', 'createdAt', 'updatedAt'])
          && b.parentId == uid()
          && userDoc(uid()).role == 'parent'
          && !exists(/databases/$(database)/documents/users/$(b.sitterId)/blocked/$(uid()))
          && b.sitterId != uid()
          && b.status == 'pending'
          && b.paymentStatus == 'pending'
          && sitter.role == 'sitter' && sitter.onboarded == true && sitter.verified == true
          && pet.ownerId == uid()
          && isDay(b.startDate) && isDay(b.endDate)
          && day(b.startDate) >= request.time - duration.value(1, 'd')
          && b.nights is int && b.nights >= 1 && b.nights <= 60
          && (day(b.endDate) - day(b.startDate)).seconds() == b.nights * 86400
          // Price is taken from the sitter's own profile, never trusted from the client.
          && b.pricePerNight == sitter.pricePerNight
          && b.totalPrice == b.nights * sitter.pricePerNight
          && isStr(b.notes, 0, 1000)
          && b.careLocation in ['sitter_home', 'parent_home']
          && (b.careLocation == 'sitter_home' || 'House sitting' in sitter.services)
          && validPetCare(b.petCare)
          && validDeclarations(b.declarations, b.careLocation == 'parent_home');
      }

      // Payment happens between the pet parent and the sitter (UPI or cash), so a stay doesn't wait on the app
      // taking money: once the sitter accepts, it is confirmed, and either side can still cancel it.
      function validTransition() {
        let from = resource.data.status;
        let to = request.resource.data.status;
        return (isSitter() && from == 'pending' && to == 'declined')
          || (isParent() && from == 'pending' && to == 'cancelled')
          || ((isParent() || isSitter()) && from == 'confirmed' && to == 'cancelled')
          || (isSitter() && from == 'confirmed' && to == 'completed'
              && request.time >= day(resource.data.endDate));
      }

      // When someone deletes their account, their name and contact details are wiped from finished bookings.
      function wipedDeclarations() {
        return data().declarations.diff(resource.data.declarations).affectedKeys()
              .hasOnly(['emergencyContactName', 'emergencyContactPhone', 'preferredVetName', 'preferredVetPhone'])
          && data().declarations.emergencyContactName == ''
          && data().declarations.emergencyContactPhone == '';
      }

      allow read: if signedIn() && (isParent() || isSitter());
      allow create: if signedIn() && validNew(data());
      // Clients may only move the status along the allowed path.
      allow update: if signedIn() && (isParent() || isSitter()) && (
        // The sitter records that the pet parent has paid them directly.
        (isSitter() && resource.data.status in ['confirmed', 'completed'] && resource.data.paymentStatus == 'pending'
          && changed().hasOnly(['paymentStatus', 'paymentMethod', 'paidAt', 'updatedAt'])
          && data().paymentStatus == 'paid' && data().paymentMethod == 'direct' && data().paidAt == request.time)
        // Account deletion: wipe the person's own details from a finished booking.
        || (isParent() && resource.data.status in ['completed', 'cancelled', 'declined']
          && changed().hasOnly(['parentName', 'parentPhoto', 'notes', 'petNotes', 'declarations'])
          && data().parentName == 'Deleted user' && data().parentPhoto == null
          && data().notes == '' && data().petNotes == '' && wipedDeclarations())
        || (isSitter() && resource.data.status in ['completed', 'cancelled', 'declined']
          && changed().hasOnly(['sitterName', 'sitterPhoto'])
          && data().sitterName == 'Deleted user' && data().sitterPhoto == null)
        ||
        // Accepting means the sitter has reviewed the declarations and care sheet, and says so.
        (isSitter() && resource.data.status == 'pending' && data().status == 'confirmed'
          && changed().hasOnly(['status', 'updatedAt', 'sitterAckAt'])
          && data().sitterAckAt == request.time)
        || (changed().hasOnly(['status', 'updatedAt']) && validTransition()));
      allow delete: if false;

      // The stay log: updates, condition at drop-off and pick-up, and incidents. Both sides can read it and add
      // to it while a stay is on; entries can never be edited or deleted, so it stands as a shared record.
      match /log/{entryId} {
        function stay() { return get(/databases/$(database)/documents/bookings/$(bookingId)).data; }
        function party() { return uid() == stay().parentId || uid() == stay().sitterId; }
        function kindOk(k) {
          return k in ['dropoff', 'pickup', 'incident']
            || (k == 'update' && uid() == stay().sitterId);
        }
        // "stays/{bookingId}/{photoId}", and the photo must really have been saved in this booking's photos.
        function ownPhoto(p) {
          return p is string && p.split('/').size() == 3 && p.split('/')[0] == 'stays' && p.split('/')[1] == bookingId
            && exists(/databases/$(database)/documents/bookings/$(bookingId)/photos/$(p.split('/')[2]));
        }

        allow read: if signedIn() && party();
        allow create: if signedIn() && party()
          && stay().status in ['confirmed', 'completed']
          && data().keys().hasOnly(['authorId', 'authorRole', 'kind', 'text', 'photos', 'createdAt'])
          && data().authorId == uid()
          && data().authorRole == (uid() == stay().sitterId ? 'sitter' : 'parent')
          && kindOk(data().kind)
          && data().text is string && data().text.size() <= 1000
          && data().photos is list && data().photos.size() <= 4
          && (data().text.size() > 0 || data().photos.size() > 0)
          && (data().photos.size() < 1 || ownPhoto(data().photos[0]))
          && (data().photos.size() < 2 || ownPhoto(data().photos[1]))
          && (data().photos.size() < 3 || ownPhoto(data().photos[2]))
          && (data().photos.size() < 4 || ownPhoto(data().photos[3]))
          && data().createdAt == request.time;
        allow update, delete: if false;
      }

      // Stay photos, as base64 JPEG text (Cloud Storage needs the paid plan). Only the two people on the booking can
      // see them or add one, and a photo can never be replaced or removed.
      match /photos/{photoId} {
        function stay() { return get(/databases/$(database)/documents/bookings/$(bookingId)).data; }
        function party() { return uid() == stay().parentId || uid() == stay().sitterId; }

        allow read: if signedIn() && party();
        allow create: if signedIn() && party()
          && stay().status in ['confirmed', 'completed']
          && photoId.matches('^[A-Za-z0-9_-]{8,40}$')
          && data().keys().hasOnly(['authorId', 'b64', 'createdAt'])
          && data().authorId == uid()
          && data().b64 is string && data().b64.size() > 100 && data().b64.size() <= 300000
          && data().createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ─── Reports ────────────────────────────────────────────────────────────
    // Write-only for users; reviewed by admins. Reporting is how people flag posts, comments, profiles
    // and messages that break the rules or put animals at risk.
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && data().keys().hasOnly(['reporterId', 'targetType', 'targetId', 'reason', 'details', 'createdAt'])
        && data().reporterId == uid()
        && data().targetType in ['post', 'comment', 'user', 'message', 'review']
        && isStr(data().targetId, 1, 200)
        && data().reason in ['spam', 'harassment', 'unsafe', 'inaccurate', 'fake', 'other']
        && data().details is string && data().details.size() <= 500
        && data().createdAt == request.time;
    }

    // ─── Reviews ───────────────────────────────────────────────────────────
    // Document ID is the booking ID: one review per completed stay.
    match /reviews/{bookingId} {
      function stay() { return get(/databases/$(database)/documents/bookings/$(bookingId)).data; }

      allow read: if true;
      allow create: if signedIn()
        && data().keys().hasOnly(['sitterId', 'bookingId', 'authorId', 'author', 'authorPhoto',
              'rating', 'text', 'petType', 'helpfulBy', 'createdAt'])
        && data().authorId == uid()
        && data().bookingId == bookingId
        && stay().parentId == uid()
        && stay().status == 'completed'
        && data().sitterId == stay().sitterId
        && data().rating is int && data().rating >= 1 && data().rating <= 5
        && isStr(data().text, 10, 1000)
        && data().helpfulBy.size() == 0;
      allow update: if signedIn() && (
        // The sitter may reply once.
        (uid() == resource.data.sitterId
          && !('response' in resource.data)
          && changed().hasOnly(['response', 'responseAt'])
          && isStr(data().response, 1, 600))
        // The author may wipe their name when deleting their account.
        || (uid() == resource.data.authorId
          && changed().hasOnly(['author', 'authorPhoto', 'authorId'])
          && data().author == 'Deleted user' && data().authorPhoto == null && data().authorId == 'deleted-user')
        // Anyone else may add or remove only themselves from helpfulBy.
        || (uid() != resource.data.authorId
          && changed().hasOnly(['helpfulBy'])
          && data().helpfulBy.toSet().difference(resource.data.helpfulBy.toSet())
               .union(resource.data.helpfulBy.toSet().difference(data().helpfulBy.toSet()))
               == [uid()].toSet())
      );
      allow delete: if false;
    }

    // ─── Vouches ───────────────────────────────────────────────────────────
    // A verified rescue or vet clinic vouches for a sitter. The ID is
    // "{orgId}_{sitterId}", so an organisation can vouch for a sitter once.
    // Only the organisation can write, so a sitter can't vouch for themselves.
    // (vouchCount on the sitter's profile moves in the same batch; see vouchCounted in the users rules.)
    match /vouches/{vouchId} {
      function org() { return userDoc(uid()); }

      allow read: if true;
      allow create: if signedIn()
        && data().keys().hasOnly(['orgId', 'orgName', 'orgPhoto', 'orgType', 'sitterId', 'note', 'createdAt'])
        && vouchId == data().orgId + '_' + data().sitterId
        && data().orgId == uid()
        && org().role in ['rescue', 'vet']
        && org().verified == true
        && org().onboarded == true
        && data().orgType == org().role
        && data().orgName == org().displayName
        && data().orgPhoto == org().photoURL
        && userDoc(data().sitterId).role == 'sitter'
        && (!('note' in data()) || (data().note is string && data().note.size() <= 300))
        && data().createdAt == request.time;
      // The organisation may edit its note, and keep its name and photo in step with its profile. Nothing else.
      allow update: if signedIn() && resource.data.orgId == uid() && (
        (org().verified == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note'])
          && (data().note is string && data().note.size() <= 300))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orgName', 'orgPhoto'])
          && data().orgName == org().displayName && data().orgPhoto == org().photoURL));
      allow delete: if signedIn() && resource.data.orgId == uid();
    }

    // ─── Conversations & messages ──────────────────────────────────────────
    // ID is "{parentId}_{sitterId}", so there is one thread per pair.
    match /conversations/{convId} {
      function member() { return uid() in resource.data.participants; }

      // A missing doc may be read (it reveals nothing) so clients can check existence.
      allow read: if signedIn() && (resource == null || member());
      allow create: if signedIn()
        && convId == data().parentId + '_' + data().sitterId
        && data().participants == [data().parentId, data().sitterId]
        && uid() in data().participants
        && userDoc(data().sitterId).role == 'sitter'
        && userDoc(data().parentId).role == 'parent';
      allow update: if signedIn() && member() && (
        (changed().hasOnly(['lastMessage', 'lastSenderId', 'lastMessageAt'])
          && data().lastSenderId == uid())
        // Account deletion: a person wipes their own name and photo from the thread.
        || (changed().hasOnly(['names', 'photos'])
          && data().names.diff(resource.data.names).affectedKeys().hasOnly([uid()])
          && data().photos.diff(resource.data.photos).affectedKeys().hasOnly([uid()])
          && data().names[uid()] == 'Deleted user' && data().photos[uid()] == null));
      allow delete: if false;

      match /messages/{messageId} {
        function convo() { return get(/databases/$(database)/documents/conversations/$(convId)).data; }
        allow read: if signedIn() && uid() in convo().participants;
        allow create: if signedIn()
          && uid() in convo().participants
          // Not if the other person has blocked the sender.
          && !exists(/databases/$(database)/documents/users/$(convo().participants[0] == uid() ? convo().participants[1] : convo().participants[0])/blocked/$(uid()))
          && data().keys().hasOnly(['senderId', 'text', 'createdAt'])
          && data().senderId == uid()
          && isStr(data().text, 1, 2000)
          && data().createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // Lets the app find all of one person's comments (to wipe their name when they delete their account).
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    // ─── Community ─────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && data().keys().hasOnly(['authorId', 'author', 'authorPhoto', 'authorRole', 'category',
              'title', 'text', 'likedBy', 'commentCount', 'createdAt'])
        && data().authorId == uid()
        && data().category in ['tip', 'question', 'story']
        // People just looking around must choose a role (and finish onboarding) before posting.
        && userDoc(uid()).role in ['parent', 'sitter', 'rescue', 'vet'] && userDoc(uid()).onboarded == true
        && data().authorRole == userDoc(uid()).role
        && isStr(data().title, 4, 120) && isStr(data().text, 10, 4000)
        && data().likedBy.size() == 0 && data().commentCount == 0;
      allow update: if signedIn() && (
        // Like / unlike: add or remove only yourself.
        (changed().hasOnly(['likedBy'])
          && data().likedBy.toSet().difference(resource.data.likedBy.toSet())
               .union(resource.data.likedBy.toSet().difference(data().likedBy.toSet()))
               == [uid()].toSet())
        // Comment counter moves by exactly one, alongside a new comment in the same batch.
        || (changed().hasOnly(['commentCount'])
          && data().commentCount == resource.data.commentCount + 1)
        // Authors may edit their own text.
        || (uid() == resource.data.authorId
          && changed().hasOnly(['title', 'text'])
          && isStr(data().title, 4, 120) && isStr(data().text, 10, 4000))
      );
      allow delete: if signedIn() && uid() == resource.data.authorId;

      match /comments/{commentId} {
        allow read: if true;
        // Account deletion: the author wipes their name from a comment.
        allow update: if signedIn() && uid() == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['author', 'authorPhoto', 'authorId'])
          && data().author == 'Deleted user' && data().authorPhoto == null && data().authorId == 'deleted-user';
        allow create: if signedIn()
          && data().keys().hasOnly(['authorId', 'author', 'authorPhoto', 'text', 'createdAt'])
          && data().authorId == uid()
          && isStr(data().text, 1, 1000);
        allow delete: if signedIn() && uid() == resource.data.authorId;
      }
    }
  }
}
