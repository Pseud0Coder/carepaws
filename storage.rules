rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos: public to read, writable only by their owner, images under 5 MB.
    match /users/{userId}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Identity documents. WRITE-ONLY for the owner: no client can ever read them back.
    // Admins review them with the Admin SDK (which bypasses these rules). Uploads are
    // allowed only before a case exists or after it was rejected, so approved documents
    // can't be swapped out afterwards.
    match /kyc/{userId}/{file} {
      allow read: if false;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && file.matches('^(id-front|id-back|selfie|address-proof|police-cert)\\.(jpg|pdf)$')
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|application/pdf')
        && (!firestore.exists(/databases/(default)/documents/kyc/$(userId))
            || firestore.get(/databases/(default)/documents/kyc/$(userId)).data.status == 'rejected');
    }

    // Stay log photos: only the pet parent and the sitter of that booking can see or add them.
    // Photos are add-only: `create` is allowed but `update` and `delete` never are, so an existing photo can't
    // be replaced (the emulator doesn't distinguish create from overwrite, but Cloud Storage does).
    match /stays/{bookingId}/{file} {
      function stay() { return firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data; }
      allow read: if request.auth != null
        && (request.auth.uid == stay().parentId || request.auth.uid == stay().sitterId);
      allow create: if request.auth != null
        && (request.auth.uid == stay().parentId || request.auth.uid == stay().sitterId)
        && stay().paymentStatus == 'paid'
        && file.matches('^[A-Za-z0-9_-]{8,40}\\.jpg$')
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow update, delete: if false;
    }
  }
}
