# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# These are public client identifiers (they ship inside the app); access is enforced by firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=carepaws-c36ae.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=carepaws-c36ae
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=carepaws-c36ae.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web client ID (…apps.googleusercontent.com) from Firebase console → Authentication →
# Sign-in method → Google → Web SDK configuration. Needed for Google sign-in on Android.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Region the Cloud Functions are deployed to (must match functions/src/index.ts).
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south1

# Set to 1 to use local Firebase emulators (npm run emulators).
# NEXT_PUBLIC_USE_EMULATORS=1

# Shown on /legal as the contact for data-deletion requests and grievances (required for Google Play).
NEXT_PUBLIC_SUPPORT_EMAIL=
